#include <string.h>
void reverse(char* s, int left, int right) {
    while (left < right) {
        char temp = s[left];
        s[left] = s[right];
        s[right] = temp;
        left++;
        right--;
    }
}
char* reverseWords(char* s) {
    int len = strlen(s);

    reverse(s, 0, len - 1);
    int start = 0;
    for (int end = 0; end <= len; end++) {
        if (s[end] == ' ' || s[end] == '\0') {
            reverse(s, start, end - 1);
            start = end + 1;
        }
    }
    int writeIdx = 0;
    for (int readIdx = 0; readIdx < len; readIdx++) {
        if (s[readIdx] != ' ') {
            if (writeIdx > 0) {
                s[writeIdx++] = ' ';
            }
            while (readIdx < len && s[readIdx] != ' ') {
                s[writeIdx++] = s[readIdx++];
            }
        }
    }
    s[writeIdx] = '\0';
    
    return s;
}
