#include <stdio.h>

int main() {
    int n;
    
    // Read the integer input
    if (scanf("%d", &n) != 1) {
        return 1;
    }
    
 
    if (n >= 1 && n <= 9) {
        const char *words[] = {"one", "two", "three", "four", "five", 
                               "six", "seven", "eight", "nine"};
        printf("%s\n", words[n - 1]);
    } else if (n > 9) {
        printf("Greater than 9\n");
    }
    
    return 0;
}
